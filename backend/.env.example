# Copy to .env for local development. NEVER commit .env.
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-value-of-at-least-32-characters
JWT_ALGORITHM=HS256
# Access token lifetime in minutes (default 7 days; no refresh tokens yet)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=postgresql+psycopg://angon:angon@localhost:5432/angon
# Comma-separated list of allowed origins (admin panel, web clients)
CORS_ORIGINS=http://localhost:3000
# Storage provider: "local" for development
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./var/uploads
# Uploads
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_EDGE=4096
MAX_IMAGE_PIXELS=60000000
# Hostnames the API answers to (Host header), comma-separated. Empty = any.
ALLOWED_HOSTS=
# In-process rate limits (login, register, uploads, posts, comments, reports).
# Must stay true in production; multi-instance deployments also need edge limits.
RATE_LIMIT_ENABLED=true
# Max size of a JSON request body in bytes (uploads use MAX_UPLOAD_BYTES).
MAX_REQUEST_BODY_BYTES=1048576
# Production startup refuses: default SECRET_KEY, CORS '*', dev DB credentials,
# STORAGE_PROVIDER=local, RATE_LIMIT_ENABLED=false.
