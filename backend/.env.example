# Copy to .env for local development. NEVER commit .env.
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://angon:angon@localhost:5432/angon
# Comma-separated list of allowed origins (admin panel, web clients)
CORS_ORIGINS=http://localhost:3000
# Storage provider: "local" for development
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./var/uploads
